# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── VetoBlast Proxy ──────────────────────────────────────────
# Local proxy daemon port
VETOBLAST_PROXY_PORT=8443

# ── DeBERTa-Sec Backend ─────────────────────────────────────
# Local FastAPI classification service
NEXT_PUBLIC_CLASSIFIER_URL=http://localhost:8000
